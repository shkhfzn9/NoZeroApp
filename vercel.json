{
    "rewrites": [
        {
            "source": "/api/supabase/(.*)",
            "destination": "https://grmcwebsgfrclyafrcio.supabase.co/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/api/supabase/(.*)",
            "headers": [
                {
                    "key": "Access-Control-Allow-Origin",
                    "value": "*"
                }
            ]
        }
    ]
}